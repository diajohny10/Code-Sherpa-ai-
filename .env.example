# Copy only for local development; never commit the real .env file.
POSTGRES_USER=sherpa
POSTGRES_DB=sherpa
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode any reserved characters in the password below.
SHERPA_DATABASE_URL=postgresql://sherpa:replace-with-a-long-random-password@127.0.0.1:5433/sherpa
SHERPA_COOKIE_SECURE=false
SHERPA_AUTH_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://127.0.0.1:5175
SHERPA_ENABLE_PAID_AI=false
# Backend only. Enter privately in the real .env; never use VITE_ for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
