# Supabase hosted PostgreSQL (NOT Supabase Auth). No local Docker is needed.
# Replace placeholders privately. Never send these URLs through chat.
# Copy the exact Session pooler host/username from Dashboard > Connect.
SHERPA_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# Separate owner/direct connection for migrations; session pooler is an IPv4 alternative.
SHERPA_MIGRATION_DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Optional: path to the root certificate downloaded from Database settings.
# SHERPA_DATABASE_CA_FILE=C:/private/supabase-root.crt
SHERPA_AUTH_ORIGINS=https://app.example.com
SHERPA_COOKIE_SECURE=true
SHERPA_ENABLE_PAID_AI=false
# Optional OpenAI (server only); enabling paid AI also requires explicit UI opt-in.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini